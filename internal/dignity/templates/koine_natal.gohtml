<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Koiné Natal Chart — {{.Name}}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 2rem; background: #1a1a2e; color: #e0e0e0; }
    h1 { color: #e2b04a; border-bottom: 2px solid #e2b04a; padding-bottom: 0.5rem; }
    h2 { color: #c9a03a; margin-top: 2rem; }
    .section { margin: 1.5rem 0; }
    .item { padding: 0.5rem 0; border-bottom: 1px solid #2a2a3e; }
    .planet { color: #e2b04a; font-weight: bold; }
    .house { color: #7eb8da; }
    .aspect { color: #c9a03a; }
    .pattern { color: #a07eb8; }
    .orb { color: #888; font-size: 0.85em; }
    .sect { padding: 0.5rem 1rem; border-radius: 4px; margin: 1rem 0; }
    .day { background: #3a2a0a; color: #e2b04a; }
    .night { background: #0a1a3a; color: #7eb8da; }
  </style>
</head>
<body>
  <h1>Koiné Natal Chart — {{.Name}}</h1>

  <div class="sect {{if .IsDay}}day{{else}}night{{end}}">
    {{if .IsDay}}☀️ Day chart — Sun above horizon, diurnal sect{{else}}🌙 Night chart — Sun below horizon, nocturnal sect{{end}}
  </div>

  <h2>Planets in Signs</h2>
  <div class="section">
    {{range .PlanetSigns}}
    <div class="item">{{.}}</div>
    {{end}}
  </div>

  <h2>Planets in Houses</h2>
  <div class="section">
    {{range .PlanetHouses}}
    <div class="item">{{.}}</div>
    {{end}}
  </div>

  <h2>Aspects</h2>
  <div class="section">
    {{range .Aspects}}
    <div class="item">{{.}}</div>
    {{end}}
  </div>

  {{if .Patterns}}
  <h2>Patterns</h2>
  <div class="section">
    {{range .Patterns}}
    <div class="item">{{.}}</div>
    {{end}}
  </div>
  {{end}}
</body>
</html>
